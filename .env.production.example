# Mastodon settings
MASTODON_VERSION=4.5.2
LOCAL_DOMAIN=mastodon.jwsoat.com

# Database — replace with a long random password
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Required secrets — generate with the commands in README.md
SECRET_KEY_BASE=CHANGE_ME
OTP_SECRET=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME

# Instance
SINGLE_USER_MODE=false
DEFAULT_LOCALE=en
RAILS_ENV=production
NODE_ENV=production

# Email — required for registrations and password resets
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_LOGIN=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_ENABLE_STARTTLS=auto
SMTP_FROM_ADDRESS=Mastodon <notifications@mastodon.jwsoat.com>

# Optional: disable Elasticsearch unless you need full-text search
ES_ENABLED=false
